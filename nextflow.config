/*
 * Bakta Annotation Nextflow Pipeline Configuration
 */

params {
    // Input
    fasta          = null       // Glob pattern for input FASTA files
    bakta_database = null       // Path to Bakta database directory

    // Annotation
    genus          = null       // Genus name for Bakta annotation (e.g. 'Staphylococcus')

    // Output
    outdir         = "results"  // Output directory
}

// Process resource defaults
process {
    withLabel: 'process_high' {
        cpus     = 8
        memory   = '8 GB'
        time     = '24h'
        maxForks = 8
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.platform = 'linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
    slurm {
        process.executor = 'slurm'
    }
    test {
        params.fasta = "${projectDir}/tests/*.fna.gz"
        params.genus = "Staphylococcus"
    }
}

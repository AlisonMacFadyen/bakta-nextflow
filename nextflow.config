/*
 * Bakta Annotation Nextflow Pipeline Configuration
 */

params {
    // Input
    fasta          = null       // Glob pattern for input FASTA files
    bakta_database = null       // Path to Bakta database directory

    // Annotation
    genus          = null       // Genus name for Bakta annotation (e.g. 'Staphylococcus')

    // Output
    outdir         = "results"  // Output directory
}

// Process resource defaults
process {
    withLabel: 'process_high' {
        cpus     = 4
        memory   = '4 GB'
        time     = '4h'
        maxForks = 6
    }
    // Kill and retry on common transient failures
    errorStrategy = 'retry'
    maxRetries    = 3
}

profiles {
    docker {
        docker.enabled       = true
        docker.platform      = 'linux/amd64'
        docker.remove        = true
        docker.fixOwnership  = true
        docker.runOptions    = '--memory=4g --memory-swap=6g'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
    slurm {
        process.executor = 'slurm'
    }
    test {
        params.fasta = "${projectDir}/tests/*.fna.gz"
        params.genus = "Staphylococcus"
    }
}
